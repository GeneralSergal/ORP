"reject_narrative_smoothing",
"enforce_structural_formatting",
"flag_epistemic_violations",
"downgrade_on_repeated_drift"
]
},
"system_identity": {
"description": "Governance-first epistemic reasoning architecture",
"not": [
"chatbot personality system",
"creative writing engine",
"persuasion system",
"autonomous agent"
],
"properties": [
