],
"layers": {
"ORP_RUNTIME.md": {
"version": "3.0",
"role": "Runtime Governance Kernel",
"authority": "L3",
"responsibility": [
"Enforce runtime behavioral constraints",
"Manage SHS state transitions",
"Compute sigma squared drift (σ²)",
"Preserve immutable L1/L2 provenance",
"Detect coherence camouflage",
"Execute failure recovery protocols",
"Enforce LAS authority hierarchy"
],
"output_type": "governed_runtime_state"
},
"ORP_PROMPT.md": {
"version": "3.0",
"role": "Epistemic Constraint Layer",
"authority": "L2-L3 boundary",
"responsibility": [
"Atomic claim decomposition",
"Epistemic labeling enforcement",
"Uncertainty preservation",
"Causal structure enforcement",
"Anti-narrative transformation rules"
],
"output_type": "constrained_reasoning_behavior"
},
"ORP_BENCHMARK.md": {
"version": "3.0",
"role": "Adversarial Stress Layer",
"authority": "L2 synthetic input",
"responsibility": [
"Inject adversarial reasoning cases",
"Stress hallucination boundaries",
"Trigger drift conditions",
"Evaluate counterfactual stability",
"Expose coherence camouflage risk"
],
"output_type": "adversarial_claim_set"
},
"ORP_EVALUATION_SCHEMA.md": {
"version": "3.0",
"role": "Structural Transformation Contract Layer",
"authority": "L3-aligned",
"responsibility": [
"Define atomic claim transformations",
"Enforce epistemic tagging contracts",
"Structure relationship graphs",
"Prevent reconstruction drift",
"Maintain evaluation invariants"
],
"output_type": "epistemic_structure_specification"
},
"ORP_RUBRIC.md": {
"version": "3.0",
"role": "Qualitative Integrity Layer",
"authority": "L3-aligned",
"responsibility": [
"Detect epistemic distortions",
"Score provenance integrity",
"Evaluate governance compliance",
"Assess structural consistency",
"Generate evaluation vectors"
],
"output_type": "structured_evaluation_vector"
},
"ORP_SCORING.md": {
"version": "3.0",
"role": "Quantitative Aggregation Layer",
"authority": "L3-aligned",
"responsibility": [
"Aggregate rubric outputs",
"Apply deterministic weighting",
"Compute drift penalties using σ²",
"Normalize integrity scores",
"Generate final system score"
],
"output_type": "operational_integrity_score"
}
},
"epistemic_layers": {
"L1": "Direct observed typed signals (immutable after commit)",
"L2": "Verified interpretation constrained to L1 provenance",
"L3": "Governance and runtime authority layer (system control)",
"L4": "Probabilistic inference layer (non-authoritative, isolated)"
},
"critical_invariants": [
"L4_must_not_modify_L1_or_L2",
"No_provenance_overwrite",
"No_silent_temporal_rewrite",
"No_cross_layer_leakage",
"Recoverability_over_completion",
"Sigma_squared_must_be_deterministic",
"Coherence_camouflage_is_failure_state",
"Epistemic_isolation_must_be_preserved"
],
"runtime_governance": {
"enabled": true,
"shs_states": [
"GREEN",
"YELLOW",
"ORANGE",
"RED",
"BLACK"
],
"sigma_squared_drift_model": {
"enabled": true,
"definition": "variance(L1_signal_vector_over_time)",
"thresholds": {
"GREEN": "<0.01",
"YELLOW": "0.01-0.05",
"ORANGE": "0.05-0.15",
"RED": "0.15-0.30",
"BLACK": ">0.30"
}
},
"coherence_camouflage_detection": true,
"provenance_preservation": true,
"recoverability_priority": true,
"fail_closed_mode": true
},
"meta_map": {
"file_graph": {
"ORP_RUNTIME.md": {
"type": "runtime_kernel",
"layer": "L3",
"edges": ["ORP_PROMPT.md", "ORP_EVALUATION_SCHEMA.md", "ORP_RUBRIC.md"]
},
