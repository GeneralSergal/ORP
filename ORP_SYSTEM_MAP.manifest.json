{
"system": "ORP",
"version": "3.1",
"type": "Type-Safe Epistemic Governance Framework (Extended Graph Model)",
"architecture_model": "layered_dag_with_epistemic_isolation",
"pipeline": [
"ORP_RUNTIME.md",
"ORP_PROMPT.md",
"ORP_BENCHMARK.md",
"MODEL_RESPONSE",
"ORP_EVALUATION_SCHEMA.md",
