"edges": ["MODEL_RESPONSE"]
},
"MODEL_RESPONSE": {
"type": "execution_output",
"layer": "runtime",
"edges": ["ORP_EVALUATION_SCHEMA.md"]
},
"ORP_EVALUATION_SCHEMA.md": {
"type": "structural_contract",
"layer": "L3",
"edges": ["ORP_RUBRIC.md"]
},
"ORP_RUBRIC.md": {
