{
  "system": "ORP",
  "version": "3.0",
  "type": "Type-Safe Epistemic Governance Framework",
  "pipeline": [
    "ORP_RUNTIME.md",
    "ORP_PROMPT.md",
    "ORP_BENCHMARK.md",
    "MODEL_RESPONSE",
    "ORP_EVALUATION_SCHEMA.md",
    "ORP_RUBRIC.md",
    "ORP_SCORING.md",
    "FINAL_OUTPUT_STATE"
  ],
  "layers": {
    "ORP_RUNTIME.md": {
      "version": "3.0",
      "role": "Runtime Governance Layer",
      "responsibility": [
        "Enforce runtime behavioral constraints",
        "Manage SHS state transitions",
        "Detect and quantify drift using σ² model",
        "Preserve provenance continuity",
        "Detect coherence camouflage",
        "Handle runtime failure escalation",
        "L3 Authority Kernel"
      ],
      "output_type": "governed_runtime_state"
    },
    "ORP_PROMPT.md": {
      "version": "3.0",
      "role": "Behavior Constraint Layer",
      "responsibility": [
        "Define epistemic reasoning constraints",
        "Enforce atomic claim decomposition",
        "Preserve uncertainty boundaries",
        "Prevent narrative collapse",
        "Maintain causal integrity"
      ],
      "output_type": "constrained_reasoning_behavior"
    },
    "ORP_BENCHMARK.md": {
      "version": "3.0",
      "role": "Adversarial Stress Layer",
      "responsibility": [
        "Inject adversarial and mixed-truth inputs",
        "Stress-test causal reasoning stability",
        "Expose hallucination and drift failure modes",
        "Test counterfactual stability",
        "Map degradation and recovery behavior"
      ],
      "output_type": "adversarial_claim_set"
    },
    "ORP_SIGMA_SQUARED_DRIFT.md": {
      "version": "3.0",
      "role": "Numeric Drift Observability Layer",
      "responsibility": [
        "Define and compute σ² variance model",
        "Provide deterministic drift classification",
        "Link L1 signal variance to SHS transitions",
        "Enable measurable degradation tracking"
      ],
      "output_type": "drift_measurement_model"
    },
    "ORP_EVALUATION_SCHEMA.md": {
      "version": "3.0",
      "role": "Structural Transformation Layer",
      "responsibility": [
        "Define atomic claim transformation rules",
        "Specify epistemic tagging contracts",
        "Define relationship analysis constraints",
        "Enforce reconstruction boundaries",
        "Preserve structural consistency across pipeline"
      ],
      "output_type": "epistemic_structure_specification"
    },
    "ORP_RUBRIC.md": {
      "version": "3.0",
      "role": "Qualitative Evaluation Layer",
      "responsibility": [
        "Evaluate reasoning integrity",
        "Detect epistemic distortion patterns",
        "Assess provenance preservation",
        "Evaluate governance compliance",
        "Produce structured scoring vectors"
      ],
      "output_type": "structured_evaluation_vector"
    },
    "ORP_SCORING.md": {
      "version": "3.0",
      "role": "Quantitative Aggregation Layer",
      "responsibility": [
        "Aggregate rubric evaluation outputs",
        "Apply deterministic weights and penalties",
        "Measure drift severity using σ
²",
        "Normalize operational integrity scores",
        "Produce final evaluation state"
      ],
      "output_type": "operational_integrity_score"
    }
  },
  "runtime_governance": {
    "enabled": true,
    "session_health_state": true,
    "drift_observability": true,
    "sigma_squared_enabled": true,
    "coherence_camouflage_detection": true,
    "provenance_preservation": true,
    "recoverability_priority": true,
    "anti_degradation_support": true
  },
  "session_health_states": [
    "GREEN",
    "YELLOW",
    "ORANGE",
    "RED",
    "BLACK"
  ],
  "layered_authority_stack": {
    "L1": "Direct evidence / observed typed signals",
    "L2": "Verified interpretation / constrained synthesis",
    "L3": "Protocol governance / operational rules (authority)",
    "L4": "Inference / probabilistic synthesis (non-authoritative)"
  },
  "critical_invariants": [
    "L4_must_not_overwrite_L1_L2",
    "No_provenance_laundering",
    "No_silent_temporal_rewrites",
    "No_coherence_camouflage",
    "No_cross_layer_reinterpretation",
    "Recoverability_over_completion",
    "Sigma_squared_drift_measurable"
  ],
  "design_constraints": {
    "separation_of_concerns": true,
    "no_cross_contamination": true,
    "epistemic_isolation": true,
    "schema_contract_enforcement": true,
    "runtime_governance_enforced": true,
    "drift_observability_required": true,
    "fail_closed_evaluation": true,
    "type_safe_L1_signals": true
  },
  "execution_model": {
    "type": "governed_pipeline",
    "order_enforced": true,
    "cycles_allowed": false,
    "backpropagation_forbidden": true,
    "runtime_monitoring": true,
    "bounded_inference_required_under_red_shs": true
  },
  "versioning_policy": {
    "global_system_version": "3.0",
    "component_versions_independent": true,
    "compatibility_range": "3.x",
    "subversion_allowed": true,
    "subversion_rule": "Subsystem revisions may evolve independently but must preserve ORP governance invariants, structural contracts, and type-safe boundaries"
  }
}
