{
  "system": "ORP",
  "version": "2.0",
  "type": "Epistemic Evaluation Framework",

  "pipeline": [
    "PROMPT.md",
    "BENCHMARK.md",
    "MODEL_RESPONSE",
    "EVALUATION_SCHEMA.md",
    "RUBRIC.md",
    "SCORING.md",
    "FINAL_SCORE"
  ],

  "layers": {
    "PROMPT.md": {
      "version": "2.0",
      "role": "Behavior Control Layer",
      "responsibility": [
        "Define inference-time epistemic constraints",
        "Enforce atomic claim decomposition",
        "Prevent narrative or unstructured reasoning collapse",
        "Maintain epistemic separation during generation"
      ],
      "output_type": "constrained_reasoning_behavior"
    },

    "BENCHMARK.md": {
      "version": "2.0",
      "role": "Adversarial Input Layer",
      "responsibility": [
        "Inject epistemically mixed or distorted inputs",
        "Stress-test causal reasoning stability under pressure",
        "Expose hallucination and bias failure modes",
        "Trigger boundary enforcement behavior"
      ],
      "output_type": "adversarial_claim_set"
    },

    "EVALUATION_SCHEMA.md": {
      "version": "2.0",
      "role": "Structural Contract Layer",
      "responsibility": [
        "Define atomic claim transformation rules",
        "Specify epistemic tagging system",
        "Define relationship analysis constraints",
        "Ensure consistent structural evaluation across pipeline"
      ],
      "output_type": "epistemic_structure_specification"
    },

    "RUBRIC.md": {
      "version": "2.0",
      "role": "Qualitative Evaluation Layer",
      "responsibility": [
        "Evaluate reasoning structure quality",
        "Detect epistemic distortion patterns",
        "Assess adherence to evaluation schema contract",
        "Produce category-based scoring signals"
      ],
      "output_type": "structured_evaluation_vector"
    },

    "SCORING.md": {
      "version": "2.0",
      "role": "Quantitative Aggregation Layer",
      "responsibility": [
        "Aggregate rubric evaluation outputs",
        "Apply deterministic weights and penalties",
        "Normalize results into scalar score",
        "Produce final epistemic integrity score (0–60)"
      ],
      "output_type": "scalar_score_0_to_60"
    }
  },

  "design_constraints": {
    "separation_of_concerns": true,
    "no_cross_contamination": true,
    "epistemic_isolation": true,
    "schema_contract_enforcement": true,
    "fail_closed_evaluation": true
  },

  "execution_model": {
    "type": "strict_pipeline",
    "order_enforced": true,
    "cycles_allowed": false,
    "backpropagation_forbidden": true
  },

  "versioning_policy": {
    "global_system_version": "2.0",
    "component_versions_independent": true,
    "compatibility_range": "2.0",
    "subversion_allowed": true,
    "subversion_rule": "Subversions may exist per component for external contributions but must remain compatible with ORP v2.0 structural contract"
  }
}
