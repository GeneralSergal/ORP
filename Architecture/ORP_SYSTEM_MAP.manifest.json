{
  "system": "ORP",
  "version": "3.0",
  "model": "Type-Safe Unified Architecture",
  "type": "canonical_manifest",
  "description": "Authoritative dependency, governance, and layer mapping for ORP v3.0",

  "pipeline_order": [
    "ORP_RUNTIME.md",
    "ORP_PROMPT.md",
    "ORP_BENCHMARK.md",
    "MODEL_RESPONSE",
    "ORP_EVALUATION_SCHEMA.md",
    "ORP_RUBRIC.md",
    "ORP_SCORING.md",
    "FINAL_OUTPUT_STATE"
  ],

  "runtime_variants": {
    "ORP_RUNTIME.md": {
      "mode": "full",
      "strictness": "highest",
      "rp_support": "low",
      "efficiency": "medium"
    },
    "ORP_RUNTIME_RP.md": {
      "mode": "rp",
      "strictness": "high",
      "rp_support": "highest",
      "efficiency": "medium-high"
    },
    "ORP_RUNTIME_LITE.md": {
      "mode": "lite",
      "strictness": "medium",
      "rp_support": "low",
      "efficiency": "highest"
    },
    "ORP_RUNTIME_RP_LITE.md": {
      "mode": "rp-lite",
      "strictness": "medium",
      "rp_support": "high",
      "efficiency": "highest"
    }
  },

  "layers": {
    "L1": {
      "description": "Observed typed signals (immutable)",
      "authority": "evidence_layer"
    },
    "L2": {
      "description": "Verified interpretation constrained to L1",
      "authority": "interpretation_layer"
    },
    "L3": {
      "description": "Governance and runtime authority",
      "authority": "control_layer"
    },
    "L4": {
      "description": "Probabilistic inference (non-authoritative)",
      "authority": "isolated_inference_layer"
    }
  },

  "files": {
    "ORP_RUNTIME.md": {
      "layer": "L3",
      "type": "runtime_kernel",
      "depends_on": [],
      "outputs": ["governed_runtime_state", "shs_state"],
      "edges": [
        "ORP_PROMPT.md",
        "ORP_EVALUATION_SCHEMA.md",
        "ORP_RUBRIC.md",
        "ORP_SIGMA_SQUARED_DRIFT.md"
      ]
    },

    "ORP_PROMPT.md": {
      "layer": "L2-L3",
      "type": "constraint_layer",
      "depends_on": ["ORP_RUNTIME.md"],
      "outputs": ["constrained_reasoning_behavior"],
      "edges": ["MODEL_RESPONSE"]
    },

    "ORP_BENCHMARK.md": {
      "layer": "L2",
      "type": "stress_layer",
      "depends_on": ["ORP_RUNTIME.md"],
      "outputs": ["adversarial_claim_set"],
      "edges": ["MODEL_RESPONSE"]
    },

    "MODEL_RESPONSE": {
      "layer": "runtime_event",
      "type": "execution_output",
      "depends_on": ["ORP_PROMPT.md", "ORP_BENCHMARK.md"],
      "outputs": ["raw_governed_output"],
      "edges": ["ORP_EVALUATION_SCHEMA.md"]
    },

    "ORP_EVALUATION_SCHEMA.md": {
      "layer": "L3",
      "type": "structural_contract",
      "depends_on": ["MODEL_RESPONSE"],
      "outputs": ["epistemic_structure_specification"],
      "edges": ["ORP_RUBRIC.md"]
    },

    "ORP_RUBRIC.md": {
      "layer": "L3",
      "type": "evaluation_layer",
      "depends_on": ["ORP_EVALUATION_SCHEMA.md"],
      "outputs": ["structured_evaluation_vector"],
      "edges": ["ORP_SCORING.md"]
    },

    "ORP_SCORING.md": {
      "layer": "L3",
      "type": "aggregation_layer",
      "depends_on": ["ORP_RUBRIC.md"],
      "outputs": ["operational_integrity_score", "drift_severity"],
      "edges": ["FINAL_OUTPUT_STATE"]
    },

    "FINAL_OUTPUT_STATE": {
      "layer": "L3",
      "type": "terminal_state",
      "depends_on": ["ORP_SCORING.md"],
      "outputs": ["final_score", "shs_state", "drift_classification"]
    }
  },

  "observability": {
    "ORP_SIGMA_SQUARED_DRIFT.md": {
      "type": "numeric_drift_model",
      "layer": "observational",
      "feeds": ["ORP_RUNTIME.md", "ORP_SCORING.md"],
      "definition": "variance(L1_signal_vector_over_time)"
    },
    "ORP_MODEL_DECAY_TRACKER.md": {
      "type": "degradation_observer",
      "layer": "observational",
      "feeds": ["ORP_ANTI_DEGRADATION.md"]
    },
    "ORP_FAILURE_MODES_CATALOG.md": {
      "type": "failure_mode_index",
      "layer": "observational",
      "feeds": ["ORP_RUNTIME.md", "ORP_DRIFT_RECOVERY_PROTOCOL.md"]
    },
    "ORP_DRIFT_RECOVERY_PROTOCOL.md": {
      "type": "recovery_logic",
      "layer": "observational",
      "feeds": ["ORP_RUNTIME.md"]
    }
  },

  "governance_documents": [
    "ORP_CORE_SPEC.md",
    "ORP_SYSTEM_ARCHITECTURE.md",
    "ORP_SYSTEM_MAP.md",
    "ORP_SYSTEM_MAP.manifest.json",
    "ORP_META_MAP.md"
  ],

  "conceptual_modules": [
    "ORP_ARCHITECTURE.md",
    "ORP_EPISTEMIC_ISOLATION.md",
    "ORP_COHERENCE_CAMOUFLAGE.md",
    "ORP_ANTI_DEGRADATION.md",
    "ORP_UNDERSTANDING_RP_DRIFT_TENDENCY.M"
  ],

  "critical_invariants": [
    "L4_must_not_modify_L1_or_L2",
    "no_provenance_overwrite",
    "no_temporal_rewrite",
    "no_cross_layer_leakage",
    "recoverability_over_completion",
    "sigma_squared_deterministic",
    "coherence_camouflage_is_failure",
    "epistemic_isolation_required",
    "pipeline_order_is_immutable"
  ],

  "versioning_policy": {
    "global_system_version": "3.0",
    "compatibility": "3.x",
    "subsystems_independent_versioning": true,
    "breaking_change_requires_major_version_bump": true
  }
}
